{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contract IPC acceptance",
  "version": "0.0.0",
  "identifier": "dev.contract-generator.acceptance",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Generated contract · real Tauri IPC",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
