<Project>
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>
  <Import Project="$(GeneratedContractRoot)/csharp/Contract.Analysis.props" />
  <Import Project="$(GeneratedContractRoot)/csharp/Contract.EffectAnalysis.props" Condition="'$(EffectSystemProjectPath)' != ''" />
</Project>
