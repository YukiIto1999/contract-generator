<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FeaturesDriver.cs" />
    <ProjectReference Include="$(GeneratedContractRoot)/csharp/types/Contract.Types.csproj" />
    <ProjectReference Include="$(GeneratedContractRoot)/csharp/provider/Contract.Provider.csproj" />
    <ProjectReference Include="$(GeneratedContractRoot)/csharp/client/Contract.Client.csproj" />
  </ItemGroup>
  <Target Name="RequireGeneratedContracts" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GeneratedContractRoot)' == ''" Text="Supply GeneratedContractRoot for the emitted Features contract" />
  </Target>
</Project>
